# Copy this file to .env.local and fill in your own values.
# Never commit real secrets to source control.
#
# All variables consumed by the Next.js frontend must be prefixed
# NEXT_PUBLIC_ so they are inlined at build time.
# Server-only variables (API routes, rate-limiter) must NOT use NEXT_PUBLIC_.

# ─────────────────────────────────────────────
# Firebase — required for Auth, Firestore, and the live leaderboard.
# Create a project at https://console.firebase.google.com and copy these
# values from Project Settings → Your Apps → Web app.
# ─────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# ─────────────────────────────────────────────
# FastAPI backend (optional).
# The Next.js route /api/assessment falls back to its own scorer when absent.
# ─────────────────────────────────────────────
FASTAPI_BACKEND_URL=http://localhost:8000

# ─────────────────────────────────────────────
# Next.js public API base URL (optional).
# Used by src/services/api.ts. Defaults to http://localhost:8000/api/v1.
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ─────────────────────────────────────────────
# Upstash Redis — required for correct, cross-instance rate limiting in
# production on Vercel (or any serverless platform).
# Without these, rate limits are per-lambda-instance only (see rate-limiter.ts).
# Create a Redis database at https://console.upstash.com and copy the REST URL
# and token from the database dashboard.
# ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ─────────────────────────────────────────────
# Judge0 / RapidAPI — optional paid DSA code-execution endpoint.
# Leave blank to use the public Judge0 Community Edition fallback
# (development only; not suitable for production traffic).
# Get a key at https://rapidapi.com/judge0-official/api/judge0-ce
# ─────────────────────────────────────────────
JUDGE0_RAPIDAPI_KEY=
